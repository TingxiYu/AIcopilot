# WORKAROUND, not a fix. Root cause NOT established -- investigate before
# trusting or narrowing this.
#
# Without this line, `npm install` fails on this machine (npm 10.8.2, node
# v20.20.2) with a crash rather than a dependency error. Verbatim:
#
#   npm error Cannot read properties of null (reading 'edgesOut')
#     at #loadPeerSet (npm/node_modules/@npmcli/arborist/lib/arborist/build-ideal-tree.js:1286:38)
#     at async #loadPeerSet (.../build-ideal-tree.js:1294:11)
#
# Note this is a TypeError (a crash), and npm emits ZERO ERESOLVE errors --
# so it is NOT a genuine peer conflict being suppressed. Setting
# legacy-peer-deps=true merely routes around the crashing code path. That is
# why the cause is recorded as unknown: the setting's semantics (skip peer
# resolution) and the observed failure (a null deref) do not obviously match.
#
# Why this is acceptable despite being a repo-wide escape hatch: it disables
# peer-conflict enforcement for the ENTIRE dependency tree, so it must not be
# load-bearing for the version pins this app depends on. It is not. The
# @langchain/react / @langchain/core pins do NOT depend on this file:
#
#   - @langchain/langgraph-sdk: enforced by @langchain/react@0.3.5 declaring a
#     bare exact dependency {"@langchain/langgraph-sdk": "1.8.10"} -- no range,
#     so no peer-resolution setting can change which version resolves.
#   - @langchain/core: enforced by this package's own exact pin "1.2.11" as a
#     direct dependency. @langchain/react only peer-ranges it (^1.1.27), which
#     1.2.11 satisfies.
#
# Verified: exactly one copy of each resolves, both hoisted to the top level.
# Removing this file breaks installs here; do not delete it without re-testing.
legacy-peer-deps=true
